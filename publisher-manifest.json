d var(--line)}\nthead th.pick{background:var(--orange)}\ntbody th{font-weight:700;width:132px;background:var(--paper);font-size:13.5px}\ntr:last-child td,tr:last-child th{border-bottom:none}\n.price{font-size:22px;font-weight:800;display:block;line-height:1.2}\n.price small{font-size:12px;font-weight:500;color:var(--ink-soft);display:block;margin-top:4px}\n.pick-col{background:#fff6f1}\n.badge{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.1em;background:var(--orange);color:#fff;padding:2px 7px;margin-left:6px;vertical-align:middle}\n.dash{color:#9b9590}\n\n/* 使用说明 */\n.steps{list-style:none;margin:0;padding:0;display:grid;gap:0;border-top:3px solid var(--line)}\n.steps li{display:grid;grid-template-columns:52px minmax(0,1fr);gap:18px;padding:20px 0;border-bottom:1px solid #dedad4}\n.steps .num{font-size:26px;font-weight:800;color:var(--orange);line-height:1}\n.steps h3{margin:0 0 4px;font-size:17px;font-weight:800}\n.steps p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n/* FAQ 双栏 */\n.faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 26px}\n.qa{border-left:4px solid var(--orange);padding:2px 0 2px 16px}\n.qa h3{margin:0 0 6px;font-size:16px;font-weight:800;line-height:1.45}\n.qa p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n/* 客户端 / 环境说明 */\n.env{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border:3px solid var(--line)}\n.env > div{padding:20px;border-right:1px solid #dedad4}\n.env > div:last-child{border-right:none}\n.env h3{margin:0 0 6px;font-size:15.5px;font-weight:800}\n.env p{margin:0;font-size:13.5px;color:var(--ink-soft)}\n\nfooter{border-top:3px solid var(--line);padding:24px 0 0;font-size:13px;color:var(--ink-soft);display:flex;flex-wrap:wrap;gap:8px 22px;justify-content:space-between}\nfooter strong{color:var(--ink);letter-spacing:.1em}\n\n@media (max-width:860px){\n  .wrap{grid-template-columns:1fr;padding:0 16px}\n  .side{position:static;max-height:none;padding:20px 0 8px;border-bottom:2px solid var(--line)}\n  .side ol{display:flex;flex-wrap:wrap;gap:0 18px;border-top:none}\n  .side ol li{border-bottom:none}\n  .side ol a{padding:8px 0;font-size:13px}\n  .side .sub{margin:8px 0 14px}\n  .side .note{display:none}\n  main{padding-top:26px}\n  .grid-2,.faq-grid{grid-template-columns:1fr}\n  .env{grid-template-columns:1fr}\n  .env > div{border-right:none;border-bottom:1px solid #dedad4}\n  .env > div:last-child{border-bottom:none}\n  section{margin-bottom:56px}\n  .timeline{padding-left:22px}\n  .timeline li{padding-left:18px}\n  .timeline li::before{left:-31px;width:13px;height:13px}\n}\n</style><div class=\"wrap\">\n  <aside class=\"side\">\n    <div class=\"mark\">西游记</div>\n    <div class=\"sub\">出行工具箱</div>\n    <ol>\n      <li><a href=\"#start\"><span>01</span>从哪里开始</a></li>\n      <li><a href=\"#plans\"><span>02</span>三档套餐对比</a></li>\n      <li><a href=\"#how\"><span>03</span>使用说明</a></li>\n      <li><a href=\"#env\"><span>04</span>设备与环境</a></li>\n      <li><a href=\"#faq\"><span>05</span>常见问题</a></li>\n    </ol>\n    <p class=\"note\">价格与权益以本页表格为准；如有调整，会先在页面上写明。</p>\n  </aside>\n\n  <main>\n    <section class=\"hero\" id=\"start\">\n      <span class=\"eyebrow\">西 游 记 · 出 门 之 前</span>\n      <h1>西游记 · 把一段长途，<br>拆成<em>四步</em>再出发</h1>\n      <p class=\"hero-lead\">我们不急着向你推销什么。先把这件事讲清楚：你是谁、要在外面待多久、有几台设备跟着你走。想明白这三点，选哪一档几乎就定了。</p>\n\n      <ol class=\"timeline\">\n        <li>\n          <span class=\"step\">第 一 步</span>\n          <h3>先认路，再谈速度</h3>\n          <p>在下单之前，先看清楚本页列出的套餐权益与限制。我们不在页面上夸口，只把能写清楚的东西写清楚。</p>\n        </li>\n        <li>\n          <span class=\"step\">第 二 步</span>\n          <h3>数一数你的设备</h3>\n          <p>手机、平板、笔记本各算一台。基础版 3 台、旗舰版 5 台、团队版 20 台，按同时在线数量计算，不是按注册数量。</p>\n        </li>\n        <li>\n          <span class=\"step\">第 三 步</span>\n          <h3>估一估你的用量</h3>\n          <p>通勤刷图、开会看文档和整晚看片子，是完全不同的三件事。把每月的量按“最忙的那一周”来估，比按平均值估更稳妥。</p>\n        </li>\n        <li>\n          <span class=\"step\">第 四 步</span>\n          <h3>选一档，然后按需升级</h3>\n          <p>不确定就从基础版开始。用量上来之后，随时可以在页面上换成更高一档，不必重新研究一遍。</p>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"plans\">\n      <h2 class=\"h2\">三档<span class=\"slash\">／</span>横向放在一张表里</h2>\n      <p class=\"lede\">同样的项目从左往右排开，哪一档多出什么，一眼能看见。橙色那一列是我们最常被问起的一档，不代表它适合所有人。</p>\n\n      <div class=\"table-scroll\">\n        <table>\n          月付与年付价格并列显示；年付为一次性支付的整年金额。\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th class=\"pick\">旗舰版<span class=\"badge\">常被问</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15<small>每月</small></span></td>\n              <td class=\"pick-col\"><span class=\"price\">¥35<small>每月</small></span></td>\n              <td><span class=\"price\">¥85<small>每月</small></span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150／年<small>相当于每月 ¥12.5</small></td>\n              <td class=\"pick-col\">¥350／年<small>相当于每月约 ¥29.2</small></td>\n              <td>¥850／年<small>相当于每月约 ¥70.8</small></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"pick-col\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"pick-col\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路</th>\n              <td>普通线路节点池</td>\n              <td class=\"pick-col\">IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>基础流媒体</td>\n              <td class=\"pick-col\">全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>企业定制路由</th>\n              <td class=\"dash\">—</td>\n              <td class=\"pick-col dash\">—</td>\n              <td>支持</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>工单</td>\n              <td class=\"pick-col\">7×24 优先工单</td>\n              <td>专属客户经理</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <span class=\"tag\">选 择 建 议</span>\n          <h3>一个人，一两台机器</h3>\n          <p>基础版通常够用。100GB 对以文字、图片和短时视频为主的日常来说有余量，把省下的钱留给路上的咖啡更实际。</p>\n        </div>\n        <div class=\"card accent\">\n          <span class=\"tag\">选 择 建 议</span>\n          <h3>全家或小团队共用</h3>\n          <p>团队版的价值不在流量数字，而在 20 台设备的余量和专属客户经理这个可以追责的人。人数上到六七位时就该考虑。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"how\">\n      <h2 class=\"h2\">使用说明<span class=\"slash\">／</span>四件小事</h2>\n      <p class=\"lede\">不需要看长文档。把下面四条做完，剩下的都能在使用过程中慢慢摸清楚。</p>\n      <ol class=\"steps\">\n        <li>\n          <span class=\"num\">01</span>\n          <div>\n            <h3>先定档，再付款</h3>\n            <p>对照上方表格选好档位。价格按页面标示的月付或年付金额为准，年付是一次性支付的整年款，不拆分退订周期。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"num\">02</span>\n          <div>\n            <h3>核对设备数量</h3>\n            <p>下单前把要同时登录的设备列一遍。超出档位上限时，多出来的那台会挤掉先登录的一台，先想好顺序再动手。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"num\">03</span>\n          <div>\n            <h3>从默认配置开始用</h3>\n            <p>第一周不要改任何设置。先用默认线路跑一遍你最常用的场景，确认体验正常，再去动那些需要调的选项。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"num\">04</span>\n          <div>\n            <h3>遇到问题走工单</h3>\n            <p>把设备型号、出现的时间和具体现象写在一条工单里。信息越具体，我们越少来回确认，你也越早拿回正常的一天。</p>\n          </div>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"env\">\n      <h2 class=\"h2\">设备与环境<span class=\"slash\">／</span>先看是否对得上</h2>\n      <p class=\"lede\">页面不提供客户端下载链接，也不承诺具体的兼容清单。请以你实际使用的设备与系统版本为准，再决定是否适合自己。</p>\n      <div class=\"env\">\n        <div>\n          <h3>桌面端</h3>\n          <p>常见桌面操作系统上的一般网络使用场景。具体客户端形态与可用的系统版本，请在使用前自行确认。</p>\n        </div>\n        <div>\n          <h3>移动端</h3>\n          <p>手机与平板各计一台。移动环境下的表现与所处网络的实际情况关系很大，本页不做性能承诺。</p>\n        </div>\n        <div>\n          <h3>多人共用</h3>\n          <p>团队版适合多人同时在线。共用的设备请事先约定使用顺序，避免在档位上限处互相挤占。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <h2 class=\"h2\">常见问题<span class=\"slash\">／</span>先看这里</h2>\n      <p class=\"lede\">这些都是真实被问得最多的问题。答案写在这儿，省下你发第一条工单的时间。</p>\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3>年付比月付便宜多少？</h3>\n          <p>基础版年付 ¥150，拆下来约每月 ¥12.5；旗舰版年付 ¥350，约每月 ¥29.2；团队版年付 ¥850，约每月 ¥70.8。差额来自一次性支付整年的方式，续费时按当时页面标示的价格执行。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>“同时在线设备”是怎么算的？</h3>\n          <p>按此刻正在登录的设备数量算，不按你注册过多少台。基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限时，新登录的会挤掉最早登录的那一台。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>流量用完了会怎样？</h3>\n          <p>本页没有写明超量后的处理细则，所以我们不在这里替它下结论。请以实际页面提示为准；如果当月用量常常贴着上限，通常意味着该换更高一档了。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>能从基础版换成旗舰版吗？</h3>\n          <p>可以在页面上改选档位。差价如何计算、从哪天起算，本页不做承诺，请在实际操作时查看结算页显示的金额再决定。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>团队版适合几个人？</h3>\n          <p>看设备总数而不只看人数。六七个人各带一台机器时，20 台的上限比较从容；如果每个人还要带平板，就该提前算一遍。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>为什么页面上没有下载链接？</h3>\n          <p>我们没有可确认的下载地址，所以不在这里放一个不确定的按钮。与其让你点进一个错地方，不如把这句话写明白：请以你实际获得的客户端为准。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>遇到问题，找谁最快？</h3>\n          <p>走工单。旗舰版是 7×24 优先工单，团队版另有专属客户经理。写清设备、时间和现象，一次说全，比反复追问来得快。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>可以退订吗？</h3>\n          <p>本页不写退款条款，因为我们手上没有可确认的细则。请不要以本页为据做出判断，务必在付款前阅读结算页上展示的完整约定。</p>\n        </article>\n      </div>\n    </section>\n\n    <footer>\n      <strong>西 游 记</strong>\n      <span>本页所述价格与权益以表格为准；未写明的事项，我们选择留白，而不是替你猜。</span>\n    </footer>\n  </main>\n</div>",
